# Injected automatically by the Railway PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set automatically by Railway at runtime — do not set manually in production
PORT=3000

# Google OAuth — create at console.cloud.google.com
# Add to Authorized JavaScript origins: http://localhost:5173, your Railway domain
# Add to Authorized redirect URIs: http://localhost:5173/api/auth/callback, https://your-domain.up.railway.app/api/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Your deployed URL — used to build the OAuth callback redirect URI
APP_URL=https://your-domain.up.railway.app

# Random secret used to sign JWTs — generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of @umich.edu emails that can access the Admin dashboard
ADMIN_EMAILS=you@umich.edu,colleague@umich.edu

# Allowed email domains for login (default: umich.edu). Add your domain here to test locally.
ALLOWED_DOMAINS=umich.edu
